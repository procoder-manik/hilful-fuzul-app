# Supabase > Project Settings > API থেকে কপি করুন
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# গোপন চাবি: কখনো কাউকে দেবেন না, শুধু সার্ভারে ব্যবহার হয়
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# সদস্যরা মোবাইল নম্বর দিয়ে লগইন করবেন; ভেতরে এটি একটি ইমেইলে রূপান্তর হয়
MEMBER_EMAIL_DOMAIN=members.hilfulfuzul.org

# প্রথম অ্যাডমিন অ্যাকাউন্ট (npm run seed চালালে তৈরি হবে)
# অ্যাডমিন ইমেইল অথবা এই মোবাইল নম্বর, যেকোনো একটি + পাসওয়ার্ড দিয়ে লগইন করবেন
ADMIN_EMAIL=admin@hilfulfuzul.org
ADMIN_PHONE=
ADMIN_PASSWORD=change-this-password

# ধাপ ৪: চ্যাট সহকারী (অন্তত একটি দিন; দুটো দিলে একটি ব্যর্থ হলে অন্যটি চলবে)
# Gemini কী: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter কী: https://openrouter.ai/keys
OPENROUTER_API_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- বিজ্ঞপ্তি: ইমেইল (SMTP) ----------
# যেকোনো SMTP চলবে। Gmail হলে: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=আপনার জিমেইল,
# SMTP_PASS=গুগলের "App password" (সাধারণ পাসওয়ার্ড নয়)। ফাঁকা রাখলে ইমেইল যাবে না, অ্যাপের ভেতরের বিজ্ঞপ্তি ঠিকই যাবে।
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="হিলফুল ফুজুল <you@gmail.com>"

# ---------- বিজ্ঞপ্তি: SMS ----------
# আপনার SMS সেবাদাতার (BulkSMSBD, Greenweb, SSL Wireless ইত্যাদি) পাঠানোর লিংক, যেখানে নম্বর ও বার্তার জায়গায়
# {to88} (8801XXXXXXXXX) অথবা {to} (01XXXXXXXXX) এবং {message} লিখতে হবে। উদাহরণ:
# SMS_URL=https://sms.example.com/api?api_key=আপনারকী&senderid=HFYS&number={to88}&message={message}
SMS_URL=
# গেটওয়ে ভুলেও 200 দিলে যে লেখা দেখে ব্যর্থ ধরা হবে (ঐচ্ছিক), যেমন: error
SMS_FAIL_TEXT=

# ---------- বাইরের ক্রন দিয়ে দৈনিক যাচাই (ঐচ্ছিক) ----------
# সার্ভার সারাদিন চালু থাকলে লাগে না। বাইরে থেকে /api/cron/notify?secret=... ডাকতে চাইলে একটি গোপন লেখা দিন।
CRON_SECRET=

# ---------- অ্যাডমিন লগইনের দুই-ধাপ (OTP) ----------
# অ্যাডমিনকে পাসওয়ার্ডের পর অথেনটিকেটর অ্যাপের কোড দিতে হয় (সবসময় চালু)।
# শুধু জরুরি অবস্থায় (ফোন হারিয়ে একমাত্র অ্যাডমিন ঢুকতে পারছেন না) সাময়িক বন্ধ করতে এখানে off লিখুন, কাজ শেষে আবার মুছে দিন।
# ADMIN_MFA=off
